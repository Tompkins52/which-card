<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: the same file goes to cloud backup and to a phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="witchcard/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="witchcard/" />
    </device-transfer>
</data-extraction-rules>
